<%@ page import="java.sql.*,com.college.util.DBUtil" %>
<%!
  static String esc(String s) {
    return s == null ? "" : s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");
  }
  static String imgSrc(String u, String ctx) {
    if (u == null || u.trim().isEmpty()) u = "images/events/default.svg";
    return (u.startsWith("http://") || u.startsWith("https://")) ? u : ctx + "/" + u;
  }
%>
<%
  if (session.getAttribute("userId") == null) { response.sendRedirect("login.jsp"); return; }
  String role = (String) session.getAttribute("role");
  int uid = (Integer) session.getAttribute("userId");
  String ctx = request.getContextPath();
  String flash = esc(request.getParameter("msg"));
%>
